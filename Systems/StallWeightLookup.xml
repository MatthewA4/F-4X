<?xml version="1.0"?>
<!--
  Weight-dependent Stall AOA Lookup for F-4 Phantom II
  Adjusts critical AOA thresholds based on landing/flight weight.
  Heavier aircraft stall at lower AOA; lighter aircraft stall at higher AOA.
  Uses a simple linear lookup between representative weights.
-->

<system name="StallWeightLookup">
  <property>fcs/stall-aoa-critical-deg</property>
  <property>fcs/stall-aoa-warning-deg</property>

  <function name="fcs/stall-aoa-critical">
    <description>Critical stall AOA as function of current weight</description>
    <table>
      <independentVar lookup="row">inertia/weight-lbs</independentVar>
      <tableData>
        30000.0  22.5
        36831.0  20.5
        45000.0  19.0
        55000.0  17.5
      </tableData>
    </table>
  </function>

  <function name="fcs/stall-aoa-warning">
    <description>Warning threshold is ~2 deg before critical</description>
    <product>
      <property>fcs/stall-aoa-critical</property>
      <value>1.0</value>
    </product>
  </function>

</system>
