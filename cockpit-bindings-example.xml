      <value>1</value>
    </binding>
    <joystick>
      <index>0</index>
      <button index="0"/>
    </joystick>
  </input>

  <input>
    <name>Joystick Missile Launch</name>
    <description>Launch missile via joystick button (requires radar lock)</description>
    <binding>
      <command>property-assign</command>
      <property>/weapons/next-ready-missile-id</property>
      <value>1</value>
    </binding>
    <joystick>
      <index>0</index>
      <button index="1"/>
    </joystick>
  </input>
  -->

</PropertyList>
